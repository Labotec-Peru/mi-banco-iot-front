pipeline {
    agent any
    environment {
        PROJECT_NAME      = 'mi-banco-iot-dev-web'
        DOCKER_IMAGE      = 'mi-banco-iot-dev-web'
        NETWORK           = 'home-net'
        SERVER_USER       = 'root'
        SERVER_HOST       = '5.189.180.249'
        SERVER_PORT       = '22'
        SSH_CREDENTIAL_ID = 'puyu-iot'
        HTTP_PORT         = '5094'
    }
    stages {
    stage('Clean workspace') {
        steps { cleanWs() }
    }
    stage('Checkout') {
        steps { checkout scm }
    }
       stage('Build Docker Image') {
    steps {
        withCredentials([file(credentialsId: 'env-development-labotec', variable: 'ENV_FILE')]) {
            // Eliminar archivos .env existentes
            sh 'rm -f .env .env.development .env.production'
            
            sh 'cp $ENV_FILE .env'
            
            sh 'echo "--- Variables en .env ---"'
            sh 'cat .env'
            sh 'echo "--- Valor de VITE_API ---"'
            sh 'grep "^VITE_API=" .env || echo "❌ VITE_API NO EXISTE"'
        }
        echo '🏗️ Construyendo imagen Docker...'
        sh "docker build --memory=6g --network=host --build-arg BUILD_MODE=development -t ${DOCKER_IMAGE} ."
    }
}
        stage('Deploy to Server') {
            steps {
                script {
                    withCredentials([
                        sshUserPrivateKey(credentialsId: SSH_CREDENTIAL_ID, keyFileVariable: 'SSH_KEY')
                    ]) {
                        sh "ssh-keyscan -p ${SERVER_PORT} ${SERVER_HOST} >> ~/.ssh/known_hosts"
                        sh "docker save ${DOCKER_IMAGE} -o ${PROJECT_NAME}.tar"
                        sh """
                        scp -i $SSH_KEY -P ${SERVER_PORT} \
                            ${PROJECT_NAME}.tar \
                            ${SERVER_USER}@${SERVER_HOST}:/tmp/
                        """
                        sh """
                        ssh -i $SSH_KEY -p ${SERVER_PORT} ${SERVER_USER}@${SERVER_HOST} '
                            set -e
                            docker load -i /tmp/${PROJECT_NAME}.tar
                            docker stop ${PROJECT_NAME} 2>/dev/null || true
                            docker rm ${PROJECT_NAME} 2>/dev/null || true
                            docker run -d \
                                --restart always \
                                --network ${NETWORK} \
                                --name ${PROJECT_NAME} \
                                ${DOCKER_IMAGE}
                        '
                        """
                    }
                }
            }
        }
    }
    post {
        success { echo '✅ Deploy completado correctamente' }
        failure  { echo '❌ Error en el pipeline' }
    }
}
